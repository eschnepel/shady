flowchart TB
  TEMPFLAG{Global flag:<br/>FC provider already<br/>includes temperature<br/>coefficient?}

  subgraph String["Per string (for each configured string)"]
    TEMPBACK[Temperature back-conversion<br/>to target-slot temperature]
    INTRADAY[Intraday deviation correction<br/>off / ramping / blending]
    CLAMP[Clamp 0..FC<br/>or inverter limit<br/>final step]
    PVSensor([Sensor: actual yield<br/>per string])
    CLIP[Clipping exclusion<br/>training]
    FCLive[raw FC value for each slot today/tomorrow]
    PV[Raw PV history]
    FIT[Model fit per slot<br/>linear / kernel / wls2 / wls3]
    TEMP[25°C normalization<br/>training]
    PRED[Prediction at 25°C]
    FC[Raw FC history]
    FCSensor([ShadyForecastSensor<br/>slot array, per string])

  end

  subgraph Agg["Aggregation (across all strings)"]
    SUMFC([Sensor: sum of corrected FC<br/>current])
    DAYSUM([Sensor: sum of corrected FC<br/>day array, incl. snapshot of past slots])
    SUMPV([Sensor: sum of actual yield<br/>current])
    INTFC([Sensor: energy integral, corrected FC<br/>reset at midnight])
    REST([Sensor: remaining-day sum])
    INTPV([Sensor: energy integral, actual<br/>reset at midnight])

  end

  subgraph Diag["Diagnostics (optional, via switch)"]
    SWITCH([Switch: diagnostics<br/>default off])
    SCATTER([Sensor: scatter chart<br/>per string, all 4 methods + today's actual value])
  end

  TEMPFLAG -. controls .-> TEMPBACK
    PV --> CLIP
    PV --> PVSensor
  TEMPFLAG -. controls .-> TEMP
    CLIP --> TEMP
    TEMP --> FIT
    SWITCH --> SCATTER
  FIT --> SCATTER
    FC --> FIT
    FIT --> PRED
    FCLive --> PRED
    PRED --> TEMPBACK --> INTRADAY
    PVSensor --> INTRADAY
    INTRADAY --> CLAMP --> FCSensor

    INTRADAY ~~~~~~ SWITCH
  FCSensor --> DAYSUM
    DAYSUM --> REST
    SUMPV --> INTPV
    SUMFC --> INTFC
  FCSensor --> SUMFC
  PVSensor --> SUMPV
  FC --> SCATTER
  PVSensor --> SCATTER
